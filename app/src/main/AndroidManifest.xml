<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.jarvis.ai">

    <!-- Core -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera / Storage -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <!-- Wake word foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Reminders / Alarms -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Calls & Contacts -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Notifications (read) -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

    <!-- Calendar -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Fitness / Step counter -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Location — Nearby Places -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Floating bubble overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- SOS emergency call -->
    <uses-permission android:name="android.permission.CALL_PRIVILEGED" />

    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Jarvis"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        tools:replace="android:allowBackup,android:theme">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Jarvis.Splash"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 🌍 Earth Map Activity -->
        <activity
            android:name=".EarthMapActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:hardwareAccelerated="true"/>

        <!-- 🐾 Animal Scanner Activity -->
        <activity
            android:name=".AnimalScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- Share receiver — catches content shared from other apps -->
        <activity
            android:name=".ShareReceiver"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Wake Word background service -->
        <service
            android:name=".WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Floating bubble overlay service -->
        <service
            android:name=".FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Reminder alarm receiver -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Notification listener service -->
        <service
            android:name=".NotificationService"
            android:exported="true"
            android:label="HENRY Notification Reader"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Live Subtitles overlay service -->
        <service
            android:name=".LiveSubtitles"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Voice Shortcut Widget -->
        <receiver
            android:name=".VoiceShortcutWidget"
            android:exported="true"
            android:label="HENRY Voice Shortcuts">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/voice_shortcut_widget_info" />
        </receiver>

        <!-- Home screen widget -->
        <receiver
            android:name=".HenryWidget"
            android:exported="true"
            android:label="H.E.N.R.Y Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/henry_widget_info" />
        </receiver>

        <!-- Morning alarm receiver (Sleep Mode) -->
        <receiver
            android:name=".MorningAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Car Mode -->
        <activity
            android:name=".CarModeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- In-App Browser -->
        <activity
            android:name=".InAppBrowser"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.Jarvis" />

        <!-- In-App Map -->
        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Live Camera Vision activity -->
        <activity
            android:name=".LiveCameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Screen Reader accessibility service -->
        <service
            android:name=".ScreenReader"
            android:exported="true"
            android:label="HENRY Screen Reader"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- HENRY Brain Map -->
        <activity
            android:name=".DashboardActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>
        <activity
            android:name=".BrainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Mental Imagery -->
        <activity
            android:name=".MentalImageryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Sensory Substitution -->
        <activity
            android:name=".SensorySubstitutionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Neural Plasticity -->
        <activity
            android:name=".NeuralPlasticityActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Default Mode Network -->
        <activity
            android:name=".DefaultModeNetworkActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Smart Memory Viewer -->
        <activity
            android:name=".SmartMemoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

        <!-- Vision Intelligence Hub -->
        <activity
            android:name=".VisionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Jarvis" />

    </application>

</manifest>
