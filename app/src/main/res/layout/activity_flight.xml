<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C1B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← BACK"
                android:textColor="#00D4FF"
                android:textSize="13sp"
                android:letterSpacing="0.12"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✈  FLIGHT TRACKER"
                android:textColor="#00D4FF"
                android:textSize="16sp"
                android:letterSpacing="0.2"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REFRESH"
                android:textColor="#005577"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#081830"
            android:layout_marginBottom="20dp"/>

        <!-- SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#050F20"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/et_flight_num"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:textColor="#00D4FF"
                android:textColorHint="#0A2A3A"
                android:textSize="18sp"
                android:hint="Enter flight number (e.g. EK001)"
                android:inputType="textCapCharacters"
                android:imeOptions="actionSearch"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRACK"
                android:textColor="#020C1B"
                android:textSize="13sp"
                android:letterSpacing="0.12"
                android:background="#00D4FF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- PROGRESS BAR -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:progressTint="#00D4FF"
            android:indeterminateTint="#00D4FF"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- LIVE DATA CARD -->
        <LinearLayout
            android:id="@+id/card_flight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#050F20"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_flight_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈ EN ROUTE"
                android:textColor="#00D4FF"
                android:textSize="22sp"
                android:letterSpacing="0.16"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_callsign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#c8e8f8"
                android:textSize="17sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3a7aa0"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3a7aa0"
                android:textSize="13sp"
                android:layout_marginBottom="14dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#081830"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALTITUDE"
                        android:textColor="#005577"
                        android:textSize="10sp"
                        android:letterSpacing="0.14"/>

                    <TextView
                        android:id="@+id/tv_altitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#00D4FF"
                        android:textSize="15sp"
                        android:fontFamily="monospace"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"
                        android:textColor="#005577"
                        android:textSize="10sp"
                        android:letterSpacing="0.14"/>

                    <TextView
                        android:id="@+id/tv_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#00D4FF"
                        android:textSize="15sp"
                        android:fontFamily="monospace"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POSITION"
                android:textColor="#005577"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00D4FF"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/btn_open_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPEN ON FLIGHTRADAR24  →"
                android:textColor="#020C1B"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:gravity="center"
                android:background="#00D4FF"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- AI RESULT CARD -->
        <LinearLayout
            android:id="@+id/card_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#050F20"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H·E·N·R·Y INTEL"
                android:textColor="#005577"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#c8e8f8"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/btn_open_map_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPEN FLIGHTRADAR24  →"
                android:textColor="#020C1B"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:gravity="center"
                android:background="#00D4FF"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- POPULAR FLIGHTS HINT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#030D1A"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRY THESE EXAMPLES"
                android:textColor="#003344"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:flexWrap="wrap">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="EK001" android:textColor="#003D55" android:textSize="13sp"
                    android:background="#050F20" android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp" android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp" android:letterSpacing="0.1"
                    android:fontFamily="monospace"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="QR001" android:textColor="#003D55" android:textSize="13sp"
                    android:background="#050F20" android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp" android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp" android:letterSpacing="0.1"
                    android:fontFamily="monospace"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AA100" android:textColor="#003D55" android:textSize="13sp"
                    android:background="#050F20" android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp" android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp" android:letterSpacing="0.1"
                    android:fontFamily="monospace"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BA001" android:textColor="#003D55" android:textSize="13sp"
                    android:background="#050F20" android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp" android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp" android:letterSpacing="0.1"
                    android:fontFamily="monospace"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
