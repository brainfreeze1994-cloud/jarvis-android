<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C1B">

    <!-- ── Blue top accent line ── -->
    <View
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_gradient_line"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ── Top bar ── -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="#020C1B"
        app:layout_constraintTop_toBottomOf="@id/top_line"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Logo + subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H·E·N·R·Y"
                android:textColor="#00D4FF"
                android:textSize="14sp"
                android:letterSpacing="0.32"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HYPERINTELLIGENCE ENGINE NEURAL REASONING YIELD"
                android:textColor="#2E6A8A"
                android:textSize="6sp"
                android:letterSpacing="0.12"/>

        </LinearLayout>

        <!-- Status badge -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STANDBY"
            android:textColor="#1A7799"
            android:textSize="8sp"
            android:letterSpacing="0.16"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_status_badge"/>

        <!-- Voice button -->
        <TextView
            android:id="@+id/btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOICE"
            android:textColor="#00BEFF"
            android:textSize="8sp"
            android:letterSpacing="0.1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Voice settings"/>


        <!-- Screen Recorder Toggle Button (re-open floating controls if exited) -->
        <ImageButton
            android:id="@+id/btn_top_screen_record"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_videocam"
            android:contentDescription="Screen Recording Controls"
            app:tint="#00D4FF"/>

        <!-- Clear button — kept OUTSIDE the scroll area so it's always visible/reachable -->
        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_delete"
            android:contentDescription="Clear"
            android:tint="#2A6A8A"/>

    </LinearLayout>

    <!-- ── Top bar divider ── -->
    <View
        android:id="@+id/top_bar_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#081830"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ── Scrollable content ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar_line"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── ORB SECTION ── -->
            <LinearLayout
                android:id="@+id/orb_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="4dp">

                <!-- Corner brackets + larger orb -->
                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:gravity="center">

                    <!-- Top-left corner -->
                    <View android:layout_width="30dp" android:layout_height="2dp"
                        android:background="#00D4FF" android:layout_gravity="top|start"/>
                    <View android:layout_width="2dp" android:layout_height="30dp"
                        android:background="#00D4FF" android:layout_gravity="top|start"/>
                    <!-- Top-right corner -->
                    <View android:layout_width="30dp" android:layout_height="2dp"
                        android:background="#00D4FF" android:layout_gravity="top|end"/>
                    <View android:layout_width="2dp" android:layout_height="30dp"
                        android:background="#00D4FF" android:layout_gravity="top|end"/>
                    <!-- Bottom-left corner -->
                    <View android:layout_width="30dp" android:layout_height="2dp"
                        android:background="#00D4FF" android:layout_gravity="bottom|start"/>
                    <View android:layout_width="2dp" android:layout_height="30dp"
                        android:background="#00D4FF" android:layout_gravity="bottom|start"/>
                    <!-- Bottom-right corner -->
                    <View android:layout_width="30dp" android:layout_height="2dp"
                        android:background="#00D4FF" android:layout_gravity="bottom|end"/>
                    <View android:layout_width="2dp" android:layout_height="30dp"
                        android:background="#00D4FF" android:layout_gravity="bottom|end"/>

                    <!-- Decorative mid-line (horizontal scan) -->
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#06203A" android:layout_gravity="center"/>

                    <!-- THE ORB — larger now -->
                    <com.jarvis.ai.OrbView
                        android:id="@+id/orb_view"
                        android:layout_width="176dp"
                        android:layout_height="176dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"/>

                </FrameLayout>

                <!-- HENRY name -->
                <TextView
                    android:id="@+id/tv_henry_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H·E·N·R·Y"
                    android:textColor="#00D4FF"
                    android:textSize="30sp"
                    android:letterSpacing="0.38"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="18dp"/>

                <!-- Sub-divider -->
                <View
                    android:layout_width="300dp"
                    android:layout_height="1dp"
                    android:background="#081830"
                    android:layout_marginTop="7dp"/>

                <!-- Tagline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HYPERINTELLIGENCE ENGINE NEURAL REASONING YIELD"
                    android:textColor="#1A5A7A"
                    android:textSize="9sp"
                    android:letterSpacing="0.16"
                    android:layout_marginTop="5dp"/>

                <!-- Orb status hint -->
                <TextView
                    android:id="@+id/tv_orb_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHAT CAN I DO FOR YOU, SIR?"
                    android:textColor="#1A7799"
                    android:textSize="13sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="14dp"/>

                <!-- ── HUD TICKER ── -->
                <com.jarvis.ai.HudTickerView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="14dp"/>

            </LinearLayout>

            <!-- ── Chips row 1 ── -->
            <LinearLayout
                android:id="@+id/chips_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/chip1"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="What's the weather?"
                    android:textColor="#1A7799"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/chip2"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Generate an image"
                    android:textColor="#1A7799"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <!-- ── Chips row 2 ── -->
            <LinearLayout
                android:id="@+id/chips_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/chip3"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Write me a Python script"
                    android:textColor="#1A7799"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/chip4"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Tell me something fascinating"
                    android:textColor="#1A7799"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <!-- ── Chips row 3 ── -->
            <LinearLayout
                android:id="@+id/chips_row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/chip5"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Latest tech news"
                    android:textColor="#1A7799"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/chip6"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Explain quantum computing"
                    android:textColor="#1A7799"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="14dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <!-- ── Chat RecyclerView ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom divider ── -->
    <View
        android:id="@+id/bottom_bar_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#081830"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ── Input bar ── -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#020C1B"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Attachment preview -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/iv_attach_preview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_chip"
                android:visibility="gone"
                android:contentDescription="Attached image"/>

            <TextView
                android:id="@+id/tv_remove_attach"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:text="x"
                android:textColor="#00BEFF"
                android:textSize="9sp"
                android:gravity="center"
                android:background="#aa020C1B"
                android:visibility="gone"
                android:layout_gravity="top|end"/>

        </FrameLayout>

        <!-- Input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_attach"
                android:contentDescription="Attach"
                android:tint="#2A6A8A"/>

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:textColor="#00D4FF"
                android:textColorHint="#1A4A5A"
                android:textSize="16sp"
                android:hint="Command HENRY…"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionSend"/>

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_mic"
                android:contentDescription="Voice input"
                android:tint="#00D4FF"/>

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_send_btn"
                android:src="@drawable/ic_send"
                android:contentDescription="Send"
                android:tint="#020C1B"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:text="TAP ORB OR MIC TO SPEAK  ·  TAP + TO ATTACH"
            android:textColor="#071525"
            android:textSize="8sp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

    <!-- ── Screen Recording Floating Action Controller (Video Camera + Pause + Exit) ── -->
    <LinearLayout
        android:id="@+id/layout_fab_record_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pause / Resume Button -->
        <FrameLayout
            android:id="@+id/btn_fab_record_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_fab_pause"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp"
            android:visibility="gone"
            android:contentDescription="Pause or Resume Recording">

            <ImageView
                android:id="@+id/iv_fab_pause_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pause"
                app:tint="#00D4FF" />
        </FrameLayout>

        <!-- Main Video Camera FAB (Tap to toggle control panel / start record) -->
        <FrameLayout
            android:id="@+id/fab_screen_record"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_fab_record"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Screen Recording Controls">

            <ImageView
                android:id="@+id/iv_fab_record_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_videocam"
                app:tint="#00FFCC"
                android:contentDescription="Record Screen" />

            <View
                android:id="@+id/dot_fab_recording"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="#FF2255"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Exit / Dismiss Button (Allows user to hide camera icon and record cleanly without it) -->
        <FrameLayout
            android:id="@+id/btn_fab_record_exit"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_fab_exit"
            android:clickable="true"
            android:focusable="true"
            android:elevation="6dp"
            android:contentDescription="Exit / Hide Recording Icon">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#88A8D0" />
        </FrameLayout>

    </LinearLayout>

    <!-- ── Screen Recording Overlay Control Panel ── -->
    <FrameLayout
        android:id="@+id/panel_screen_record_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_record_panel"
        android:elevation="12dp"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layout_fab_record_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_overlay_status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎥"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_overlay_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SCREEN RECORDING CONTROLLER"
                    android:textColor="#00FFCC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overlay_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#00D4FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="#15263F"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btn_close_record_overlay"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_delete"
                    app:tint="#7A92B4"
                    android:contentDescription="Close Panel" />
            </LinearLayout>

            <!-- Quick Setting Toggles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chip_overlay_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#1E3250"
                    android:paddingHorizontal="10dp"
                    android:text="🎙️ Mic: ON"
                    android:textColor="#00FFCC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chip_overlay_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#0F1A2A"
                    android:paddingHorizontal="10dp"
                    android:text="⚙️ 1080p 60fps"
                    android:textColor="#88A8D0"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chip_overlay_clean_record"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:background="#0F1A2A"
                    android:paddingHorizontal="10dp"
                    android:text="👻 Clean: OFF"
                    android:textColor="#88A8D0"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btn_overlay_studio"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="#0F1A2A"
                    android:paddingHorizontal="8dp"
                    android:text="🎬 Studio / Posts"
                    android:textColor="#00D4FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Main Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_overlay_start_stop"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#00FFCC"
                    android:text="🔴 START RECORDING"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_overlay_pause_resume"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#162A45"
                    android:text="⏸ Pause"
                    android:textColor="#00D4FF"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
