<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d0d">

    <!-- Gold top accent line -->
    <View
        android:id="@+id/top_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#c9a84c"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="#0d0d0d"
        app:layout_constraintTop_toBottomOf="@id/top_line"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="H.E.N.R.Y"
            android:textColor="#c9a84c"
            android:textSize="15sp"
            android:letterSpacing="0.25"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STANDBY"
            android:textColor="#c9a84c"
            android:textSize="9sp"
            android:letterSpacing="0.15"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="4dp"/>

        <!-- VOICE accent button -->
        <TextView
            android:id="@+id/btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🇬🇧 VOICE"
            android:textColor="#c9a84c"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Voice accent"/>

        <ImageButton
            android:id="@+id/btn_clear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_delete"
            android:contentDescription="Clear"
            android:tint="#4a4a3a"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/top_bar_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2a2318"
        app:layout_constraintTop_toBottomOf="@id/topbar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar_line"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Welcome / Orb section -->
            <LinearLayout
                android:id="@+id/orb_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="8dp">

                <!-- Corner bracket frame + orb -->
                <FrameLayout
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:gravity="center">

                    <View android:layout_width="22dp" android:layout_height="1dp"
                        android:background="#c9a84c" android:layout_gravity="top|start"/>
                    <View android:layout_width="1dp" android:layout_height="22dp"
                        android:background="#c9a84c" android:layout_gravity="top|start"/>
                    <View android:layout_width="22dp" android:layout_height="1dp"
                        android:background="#c9a84c" android:layout_gravity="top|end"/>
                    <View android:layout_width="1dp" android:layout_height="22dp"
                        android:background="#c9a84c" android:layout_gravity="top|end"/>
                    <View android:layout_width="22dp" android:layout_height="1dp"
                        android:background="#c9a84c" android:layout_gravity="bottom|start"/>
                    <View android:layout_width="1dp" android:layout_height="22dp"
                        android:background="#c9a84c" android:layout_gravity="bottom|start"/>
                    <View android:layout_width="22dp" android:layout_height="1dp"
                        android:background="#c9a84c" android:layout_gravity="bottom|end"/>
                    <View android:layout_width="1dp" android:layout_height="22dp"
                        android:background="#c9a84c" android:layout_gravity="bottom|end"/>

                    <com.jarvis.ai.OrbView
                        android:id="@+id/orb_view"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_henry_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H.E.N.R.Y"
                    android:textColor="#c9a84c"
                    android:textSize="28sp"
                    android:letterSpacing="0.3"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="20dp"/>

                <View
                    android:layout_width="280dp"
                    android:layout_height="1dp"
                    android:background="#1e1a0e"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGHLY ENHANCED NEURAL REASONING FOR YOU"
                    android:textColor="#4a4030"
                    android:textSize="8sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tv_orb_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHAT CAN I DO FOR YOU, SIR?"
                    android:textColor="#6a5c38"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="18dp"/>

            </LinearLayout>

            <!-- Chips row 1 -->
            <LinearLayout
                android:id="@+id/chips_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/chip1"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="What's the weather in Dubai?"
                    android:textColor="#7a6b44"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/chip2"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Generate image of a warrior"
                    android:textColor="#7a6b44"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <!-- Chips row 2 -->
            <LinearLayout
                android:id="@+id/chips_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/chip3"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Write me a Python script"
                    android:textColor="#7a6b44"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/chip4"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Tell me something fascinating"
                    android:textColor="#7a6b44"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <!-- Chips row 3 -->
            <LinearLayout
                android:id="@+id/chips_row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/chip5"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Latest tech news today"
                    android:textColor="#7a6b44"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/chip6"
                    style="@android:style/Widget.Material.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Explain quantum computing"
                    android:textColor="#7a6b44"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>

            <!-- Chat RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Line above input -->
    <View
        android:id="@+id/bottom_bar_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e1a0e"
        app:layout_constraintBottom_toTopOf="@id/input_container"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Input bar -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0d0d0d"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Attachment preview -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/iv_attach_preview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_chip"
                android:visibility="gone"
                android:contentDescription="Attached image"/>

            <TextView
                android:id="@+id/tv_remove_attach"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:text="x"
                android:textColor="#c9a84c"
                android:textSize="9sp"
                android:gravity="center"
                android:background="#aa0d0d0d"
                android:visibility="gone"
                android:layout_gravity="top|end"/>

        </FrameLayout>

        <!-- Input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_box"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_attach"
                android:contentDescription="Attach"
                android:tint="#4a4030"/>

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:textColor="#c9a84c"
                android:textColorHint="#3a3020"
                android:textSize="13sp"
                android:hint="Command HENRY..."
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionSend"/>

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_mic"
                android:contentDescription="Voice"
                android:tint="#4a4030"/>

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_send_btn"
                android:src="@drawable/ic_send"
                android:contentDescription="Send"
                android:tint="#0d0d0d"/>

        </LinearLayout>

        <!-- Bottom hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:text="TAP ORB OR MIC TO SPEAK  ·  TAP + TO ATTACH FILES"
            android:textColor="#2a2418"
            android:textSize="8sp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
