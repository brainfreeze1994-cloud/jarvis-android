<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#020C1B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#040F1D">

        <Button
            android:id="@+id/np_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textColor="#00FF99"
            android:background="@null"
            android:textSize="11sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/np_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ NEURAL PLASTICITY"
                android:textColor="#00FF99"
                android:textSize="13sp"
                android:letterSpacing="0.2"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/np_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◈ SCORE: 0"
                    android:textColor="#2A6A4A"
                    android:textSize="9sp"
                    android:paddingEnd="12dp"/>

                <TextView
                    android:id="@+id/np_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 STREAK: 0"
                    android:textColor="#2A6A4A"
                    android:textSize="9sp"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="60dp" android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/np_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <LinearLayout
                android:id="@+id/np_exercise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/np_challenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#C0FFD0"
                    android:textSize="17sp"
                    android:lineSpacingMultiplier="1.5"
                    android:paddingBottom="20dp"/>

                <LinearLayout
                    android:id="@+id/np_answers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <Button
                    android:id="@+id/np_btn_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="CHECK ANSWER"
                    android:textColor="#020C1B"
                    android:background="#00FF99"/>

                <TextView
                    android:id="@+id/np_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="15sp"
                    android:paddingTop="12dp"
                    android:lineSpacingMultiplier="1.4"/>

                <Button
                    android:id="@+id/np_btn_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="NEXT CHALLENGE →"
                    android:textColor="#00FF99"
                    android:background="@drawable/bg_chip"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
