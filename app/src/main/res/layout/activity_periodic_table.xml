<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03080F">

    <!-- 0. Dynamic Holographic Animated Background (Beams + Grid + Particles) -->
    <com.jarvis.ai.HolographicWorkshopBackgroundView
        android:id="@+id/holo_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 1. STARK WORKSHOP HUD HEADER BAR -->
    <LinearLayout
        android:id="@+id/stark_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1500D4FF"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btn_periodic_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ LAB"
                android:textColor="#00FFCC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#1A00FFCC"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_lab_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STARK PERIODIC MATRIX"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tv_lab_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- INITIATED -- • [SEGMENTS: 118 ELEMENTS]"
                    android:textColor="#00FFCC"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_voice_inspect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="🔊 INTEL"
                android:textColor="#00D4FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#1500D4FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:clickable="true"
                android:focusable="true"/>
        </RelativeLayout>

        <!-- Segmented Holographic Tab Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:background="#0A1526"
            android:padding="2dp">

            <TextView
                android:id="@+id/tab_matrix"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚛ 3D MATRIX"
                android:textColor="#00FFCC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#2500FFCC"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="3dp" android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tab_synthesizer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚡ SYNTHESIZER"
                android:textColor="#88AABB"
                android:textSize="11sp"
                android:gravity="center"
                android:background="#0A1526"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="3dp" android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tab_mixer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🧪 MIXER"
                android:textColor="#88AABB"
                android:textSize="11sp"
                android:gravity="center"
                android:background="#0A1526"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="3dp" android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tab_bohr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🔬 BOHR"
                android:textColor="#88AABB"
                android:textSize="11sp"
                android:gravity="center"
                android:background="#0A1526"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 2. SEARCH & CATEGORY FILTER BAR (For Matrix mode) -->
    <LinearLayout
        android:id="@+id/search_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/stark_header"
        android:orientation="vertical"
        android:background="#0A1220"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <!-- Search Input Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#151F33"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="13sp"
                android:layout_marginEnd="6dp"/>

            <EditText
                android:id="@+id/et_element_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search symbol, name, or atomic # (e.g. Ti, Gold, 26)..."
                android:textColorHint="#607D99"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@null"
                android:singleLine="true"
                android:imeOptions="actionDone"/>

            <TextView
                android:id="@+id/btn_clear_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#88AABB"
                android:textSize="14sp"
                android:padding="6dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Horizontal Scrollable Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/category_chips_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Dynamically populated chips in Activity -->
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 3. MAIN CONTENT CONTAINER -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/search_filter_bar">

        <!-- ================= MODE 1: HOLOGRAPHIC PERIODIC TABLE MATRIX ================= -->
        <RelativeLayout
            android:id="@+id/panel_matrix"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Zoom & Pan Hint Banner -->
            <LinearLayout
                android:id="@+id/matrix_hint_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:background="#0D182A">

                <TextView
                    android:id="@+id/tv_matrix_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 Tap element for Bohr atomic telemetry • Drag to combine"
                    android:textColor="#00FFCC"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tv_element_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="118 / 118"
                    android:textColor="#00D4FF"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Scrollable 18-Column Holographic Matrix -->
            <HorizontalScrollView
                android:id="@+id/h_scroll_table"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/matrix_hint_bar"
                android:scrollbars="horizontal">

                <ScrollView
                    android:id="@+id/v_scroll_table"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical">

                    <FrameLayout
                        android:id="@+id/table_layer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"/>
                </ScrollView>
            </HorizontalScrollView>

            <!-- Floating Selected Element Mini-HUD Card at Bottom -->
            <LinearLayout
                android:id="@+id/card_mini_inspect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#E5071424"
                android:padding="12dp"
                android:elevation="6dp"
                android:visibility="gone">

                <!-- Glowing Tile Preview -->
                <LinearLayout
                    android:id="@+id/mini_tile_preview"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#2000FFCC"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/mini_z_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26"
                        android:textColor="#88AADD"
                        android:textSize="9sp"/>

                    <TextView
                        android:id="@+id/mini_symbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fe"
                        android:textColor="#00FFCC"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mini_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iron (Transition Metal)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/mini_econfig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[Ar] 3d⁶ 4s² • 55.845 u"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_inspect_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPAND ↗"
                    android:textColor="#001520"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#00FFCC"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- ================= MODE 2: TONY STARK ARC REACTOR / PARTICLE SYNTHESIZER ================= -->
        <ScrollView
            android:id="@+id/panel_synthesizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Synthesizer Canvas View -->
                <com.jarvis.ai.ArcReactorSynthesizerView
                    android:id="@+id/arc_synth_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#1000E5FF"/>

                <!-- Arc Reactor Power Diagnostics -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:background="#0E1E34"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PARTICLE FOCUS"
                            android:textColor="#607D99"
                            android:textSize="9sp"/>
                        <TextView
                            android:id="@+id/tv_synth_focus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100% COLLIMATED"
                            android:textColor="#00FFCC"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CORE OUTPUT"
                            android:textColor="#607D99"
                            android:textSize="9sp"/>
                        <TextView
                            android:id="@+id/tv_synth_output"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.8 GJ / SECOND"
                            android:textColor="#00D4FF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOXICITY LEVEL"
                            android:textColor="#607D99"
                            android:textSize="9sp"/>
                        <TextView
                            android:id="@+id/tv_synth_toxicity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0% (NON-TOXIC)"
                            android:textColor="#00FF88"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Synthesis Target Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT SYNTHESIS TARGET // EXOTIC ALLOY / NEW ELEMENT:"
                    android:textColor="#88AADD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Preset Synthesis Recipes -->
                <LinearLayout
                    android:id="@+id/recipes_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- Laser Accelerator Launch Button -->
                <TextView
                    android:id="@+id/btn_ignite_laser"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⚡ FIRE PARTICLE ACCELERATOR LASER"
                    android:textColor="#001520"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#00FFCC"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </ScrollView>

        <!-- ================= MODE 3: COMPOUND MIXER & REACTION LAB ================= -->
        <ScrollView
            android:id="@+id/panel_mixer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧪 ELEMENT COMBINER AND REACTION VESSEL"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select any two elements to observe real chemical synthesis, bonding geometry, and industrial application."
                    android:textColor="#88AADD"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>

                <!-- Two Reactant Element Slots -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <!-- Slot A -->
                    <LinearLayout
                        android:id="@+id/slot_element_a"
                        android:layout_width="90dp"
                        android:layout_height="100dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#2000FFCC"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_slot_a_z"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="11"
                            android:textColor="#88AADD"
                            android:textSize="10sp"/>

                        <TextView
                            android:id="@+id/tv_slot_a_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Na"
                            android:textColor="#00FFCC"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_slot_a_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sodium"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="#00D4FF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginHorizontal="16dp"/>

                    <!-- Slot B -->
                    <LinearLayout
                        android:id="@+id/slot_element_b"
                        android:layout_width="90dp"
                        android:layout_height="100dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#20FF9933"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_slot_b_z"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="17"
                            android:textColor="#88AADD"
                            android:textSize="10sp"/>

                        <TextView
                            android:id="@+id/tv_slot_b_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cl"
                            android:textColor="#FF9933"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_slot_b_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chlorine"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Reaction Result Card -->
                <LinearLayout
                    android:id="@+id/card_mixer_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0F2038"
                    android:padding="16dp"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/tv_compound_formula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NaCl • Sodium Chloride"
                        android:textColor="#00FFCC"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_compound_common"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Common Name: Table Salt"
                        android:textColor="#00D4FF"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#204060"
                        android:layout_marginVertical="10dp"/>

                    <TextView
                        android:id="@+id/tv_compound_bond"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bond Type: Ionic • Crystal Lattice Structure"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/tv_compound_fact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 The salt on your food — a violently explosive metal and a toxic gas combine into something you eat every day."
                        android:textColor="#A0C0E0"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Common Compound Quick Picker Pills -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUICK SYNTHESIS SHORTCUTS:"
                    android:textColor="#607D99"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/common_compounds_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>

        <!-- ================= MODE 4: BOHR ORBITAL SIMULATOR ================= -->
        <ScrollView
            android:id="@+id/panel_bohr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Interactive Bohr Canvas -->
                <com.jarvis.ai.BohrAtomView
                    android:id="@+id/bohr_atom_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:background="#0A1526"/>

                <TextView
                    android:id="@+id/tv_bohr_element_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iron (Fe) • Z=26"
                    android:textColor="#00FFCC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"/>

                <TextView
                    android:id="@+id/tv_bohr_econfig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shells: K:2 | L:8 | M:14 | N:2  •  [Ar] 3d⁶ 4s²"
                    android:textColor="#00D4FF"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>

                <!-- Bohr Diagnostics Matrix -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0E1D30"
                    android:padding="12dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tv_bohr_shells_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Principal Quantum Shells: 4 Active Orbitals"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_bohr_valence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Valence Electrons: 2 • Oxidation States: +2, +3, +6"
                        android:textColor="#A0C0E0"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tv_bohr_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Iron is a ferromagnetic transition metal forming much of Earth's outer and inner core, hemoglobin in blood, and high-tensile structural steel."
                        android:textColor="#88AADD"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</RelativeLayout>
