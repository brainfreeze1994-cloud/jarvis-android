<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070C14">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0D1524"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#00FFCC"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎥 SCREEN RECORDING STUDIO"
                android:textColor="#00FFCC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H·E·N·R·Y Social &amp; Video Publisher"
                android:textColor="#7A92B4"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#15263F"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="00:00"
            android:textColor="#00D4FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Video Player Preview Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#0A111E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="#000000">

                        <VideoView
                            android:id="@+id/videoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />

                        <ImageView
                            android:id="@+id/btnPlayOverlay"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:background="@android:drawable/btn_star_big_off"
                            android:backgroundTint="#88000000"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="#00FFCC"
                            android:padding="12dp"
                            android:contentDescription="Play Video" />
                    </FrameLayout>

                    <!-- Video Telemetry Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvVideoDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Resolution: 1080p • 60 FPS • Size: -- MB"
                            android:textColor="#88A0C0"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnDeleteVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗑️ Delete"
                            android:textColor="#FF5577"
                            android:textSize="12sp"
                            android:padding="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 🎙️ Separate Temporary Microphone Audio Track Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMicAudioTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0A1424">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎙️ Microphone Audio Track (Temp File)"
                            android:textColor="#00FFCC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAudioStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#15263F"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="AAC 44.1kHz"
                            android:textColor="#00D4FF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTempAudioPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cache: /data/.../temp_mic_audio/..."
                        android:textColor="#7A92B4"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnPlayAudioTrack"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="▶ Listen to Mic Audio"
                            android:textSize="11sp"
                            android:textColor="#000000"
                            android:backgroundTint="#00FFCC"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnShareAudioTrack"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="📤 Export Mic Audio"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#1B3252" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Social Publisher Target Bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="🚀 TARGET PLATFORM &amp; VIRAL STRATEGY"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Platform Selector Horizontal Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/chipTikTok"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🎵 TikTok"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="#00FFCC"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/chipYouTube"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="▶️ YouTube Shorts"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#A0B8D8"
                    android:background="#111B2C"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/chipReels"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📸 IG Reels"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#A0B8D8"
                    android:background="#111B2C"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Tone / Niche Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutToneChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/toneViral"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="🔥 Viral Hook"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:background="#1E3250"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/toneTech"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="💻 Tech &amp; Tutorial"
                        android:textColor="#7A92B4"
                        android:textSize="11sp"
                        android:background="#0F1A2A"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/toneGaming"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="🎮 Gaming &amp; Action"
                        android:textColor="#7A92B4"
                        android:textSize="11sp"
                        android:background="#0F1A2A"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/toneAesthetic"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="✨ Aesthetic &amp; Cool"
                        android:textColor="#7A92B4"
                        android:textSize="11sp"
                        android:background="#0F1A2A" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Video Context / Topic Input -->
            <EditText
                android:id="@+id/etVideoTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#0D1626"
                android:padding="12dp"
                android:hint="Video description / topic (e.g., Cool gameplay clip, Jarvis UI walkthrough...)"
                android:textColor="#FFFFFF"
                android:textColorHint="#4E6788"
                android:textSize="12sp"
                android:inputType="text" />

            <!-- AI Caption Generation Button -->
            <Button
                android:id="@+id/btnGenerateCaption"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#00FFCC"
                android:text="✨ GENERATE AI CAPTION &amp; HASHTAGS"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- AI Generated Caption Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#0D1626">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCaptionCardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📝 READY CAPTION &amp; HASHTAGS"
                            android:textColor="#00D4FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnCopyCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋 Copy Text"
                            android:textColor="#00FFCC"
                            android:textSize="12sp"
                            android:padding="4dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etCaptionOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#070C14"
                        android:padding="10dp"
                        android:minLines="4"
                        android:gravity="top"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:hint="Your viral caption and hashtags will appear here..."
                        android:textColorHint="#4E6788" />

                    <!-- Quick Hashtag Pills -->
                    <TextView
                        android:id="@+id/tvHashtagsPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#00FFCC"
                        android:textSize="11sp"
                        android:text="#TikTok #Shorts #Tech #ScreenRecording #Viral #HENRY #HENRYAI" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Direct Publish / Share Action Buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="🚀 DIRECT PUBLISH / EXPORT"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Primary Platform Share Button -->
            <Button
                android:id="@+id/btnPublishPlatform"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FE2C55"
                android:text="🎵 POST DIRECTLY TO TIKTOK"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- YouTube Shorts Button -->
            <Button
                android:id="@+id/btnPublishYouTube"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF0000"
                android:text="▶️ POST TO YOUTUBE / SHORTS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Standard Share / Save -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnShareAll"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1B2D46"
                    android:text="📤 Share to Any App"
                    android:textColor="#00FFCC"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnOpenGallery"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1B2D46"
                    android:text="📁 View in Gallery"
                    android:textColor="#00D4FF"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
