<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#020C1B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#040F1D">

        <Button
            android:id="@+id/ss_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textColor="#FF9944"
            android:background="@null"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/ss_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◈ SENSORY SUBSTITUTION"
            android:textColor="#FF9944"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:gravity="center"/>

        <View android:layout_width="60dp" android:layout_height="1dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/ss_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cross-modal perception engine."
        android:textColor="#886633"
        android:textSize="13sp"
        android:padding="16dp"
        android:lineSpacingMultiplier="1.4"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/ss_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <LinearLayout
                android:id="@+id/ss_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/ss_output"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF9944"
        android:textSize="14sp"
        android:padding="16dp"
        android:minHeight="80dp"
        android:background="#040F1D"
        android:lineSpacingMultiplier="1.4"/>
</LinearLayout>
