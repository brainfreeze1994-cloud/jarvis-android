<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C1B">

    <!-- 1. ORBIT VIEW (Full screen background viewport) -->
    <com.jarvis.ai.AsteroidOrbitView
        android:id="@+id/asteroid_orbit_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="280dp"/>

    <!-- 2. TOP HEADER & NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/space_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D9020C1B"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_space_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#00D4FF"
                android:textSize="22sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- NASA Insignia & Title -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NASA"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:background="#D12630"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EYES ON ASTEROIDS"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:letterSpacing="0.15"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- NASA 3D Web & Search Buttons -->
            <TextView
                android:id="@+id/btn_nasa_web"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D WEB ↗"
                android:textColor="#00D4FF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:background="#1500D4FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <ProgressBar
                android:id="@+id/space_progress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:indeterminateTint="#00D4FF"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Mode Selector Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tab_asteroids"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="☄️ 3D ORBIT"
                android:textColor="#00FF99"
                android:textSize="11sp"
                android:gravity="center"
                android:textStyle="bold"
                android:background="#2000FF99"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="4dp" android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tab_ast_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📋 ASTEROID LIST"
                android:textColor="#88AABB"
                android:textSize="11sp"
                android:gravity="center"
                android:background="#0A1828"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="4dp" android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tab_iss"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🛸 ISS"
                android:textColor="#88AABB"
                android:textSize="11sp"
                android:gravity="center"
                android:background="#0A1828"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="4dp" android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/tab_apod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🔭 APOD"
                android:textColor="#88AABB"
                android:textSize="11sp"
                android:gravity="center"
                android:background="#0A1828"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. ASTEROID WATCH BOTTOM CARD (Exact replica of NASA Eyes on Asteroids UI) -->
    <LinearLayout
        android:id="@+id/card_asteroid_watch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#EA07101E"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp">

        <!-- Top "See all asteroids" Action Link -->
        <TextView
            android:id="@+id/btn_see_all_asteroids"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ See all asteroids"
            android:textColor="#00FF99"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Card Header: Hexagon Icon + Title + Pager -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬡"
                    android:textColor="#00FF99"
                    android:textSize="18sp"
                    android:layout_marginEnd="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asteroid Watch"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The next five closest approaches to Earth"
                        android:textColor="#7799AA"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Pager indicator: 1 OF 5 -->
            <TextView
                android:id="@+id/tv_ast_pager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="1 OF 5"
                android:textColor="#00FF99"
                android:textSize="12sp"
                android:fontFamily="monospace"/>
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#153050"
            android:layout_marginVertical="8dp"/>

        <!-- Middle Content: Left Details & Right 3D Rock Visual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: Asteroid Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Asteroid Name -->
                <TextView
                    android:id="@+id/tv_ast_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2025 QV5"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"/>

                <!-- Approach Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATE"
                    android:textColor="#557788"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"/>

                <TextView
                    android:id="@+id/tv_ast_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEP 2, 2026  3:46:02 PM"
                    android:textColor="#CCE0EE"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp"/>

                <!-- Distance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE"
                    android:textColor="#557788"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"/>

                <TextView
                    android:id="@+id/tv_ast_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5,433,910 km"
                    android:textColor="#00D4FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Right: 3D Asteroid Rock Graphic & Estimated Size -->
            <LinearLayout
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <com.jarvis.ai.AsteroidRockView
                    android:id="@+id/ast_rock_view"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="4dp"/>

                <!-- Scale Ruler & Estimated Size -->
                <TextView
                    android:id="@+id/tv_ast_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11.5 m"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ESTIMATED]"
                    android:textColor="#7799AA"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"/>
            </LinearLayout>
        </LinearLayout>

        <!-- LIVE COUNTDOWN BOX (Green rounded neon badge like screenshot) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0A2218"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE COUNTDOWN"
                android:textColor="#00FF99"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tv_ast_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T - 01 : 02 : 40 : 09"
                android:textColor="#00FF99"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAYS    HOURS    MINUTES    SECONDS"
                android:textColor="#55AA80"
                android:textSize="9sp"
                android:letterSpacing="0.12"/>
        </LinearLayout>

        <!-- Carousel Navigation & Live Status Footer -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Left / Right Carousel Controls & Dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btn_prev_ast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←"
                    android:textColor="#00FF99"
                    android:textSize="18sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="#1500FF99"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tv_ast_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● ○ ○ ○ ○"
                    android:textColor="#00FF99"
                    android:textSize="13sp"
                    android:letterSpacing="0.3"
                    android:layout_marginHorizontal="12dp"/>

                <TextView
                    android:id="@+id/btn_next_ast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="#00FF99"
                    android:textSize="18sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="#1500FF99"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Right: Real-time Live Clock Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 LIVE"
                    android:textColor="#00FF99"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tv_live_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEP 01, 2026  01:05:54 pm"
                    android:textColor="#88AABB"
                    android:textSize="10sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- 4. ISS VIEW PANEL (Toggled via ISS Tab) -->
    <LinearLayout
        android:id="@+id/card_iss_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#EA051020"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛸  INTERNATIONAL SPACE STATION (ISS)"
            android:textColor="#00D4FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_iss_pos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45.120° N   12.340° E"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_iss_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orbiting at ~408 km • 27,600 km/h • 1 orbit every 92.6 min • 7 astronauts onboard"
            android:textColor="#7799AA"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/btn_spot_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPOT THE STATION — NASA LIVE  →"
            android:textColor="#020C1B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:background="#00D4FF"
            android:paddingVertical="10dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 5. NASA APOD PANEL (Toggled via APOD Tab) -->
    <LinearLayout
        android:id="@+id/card_apod_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#EA051020"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔭  NASA ASTRONOMY PICTURE OF THE DAY"
            android:textColor="#CC88FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tv_nasa_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading NASA APOD…"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_nasa_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fetching latest deep space observation from NASA Hubble and James Webb Space Telescope."
            android:textColor="#88AABB"
            android:textSize="12sp"
            android:maxLines="4"/>
    </LinearLayout>

    <!-- 6. ASTEROID RECYCLERVIEW LIST PANEL (Toggled via LIST Tab or See all asteroids) -->
    <LinearLayout
        android:id="@+id/panel_asteroid_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/space_header"
        android:orientation="vertical"
        android:background="#07101E"
        android:visibility="gone">

        <!-- List Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#0F1D32">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☄️"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEAR-EARTH ASTEROIDS (NEOs)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tv_ast_list_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fetched from NASA JPL Asteroid Feed • Tap any to focus orbit"
                    android:textColor="#00FF99"
                    android:textSize="10sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ast_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 TRACKED"
                android:textColor="#00D4FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#1500D4FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A2D48"/>

        <!-- RECYCLERVIEW: Live Asteroid Data Cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_asteroids"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            android:scrollbars="vertical"/>
    </LinearLayout>

</RelativeLayout>
