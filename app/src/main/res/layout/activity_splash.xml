<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070d1a"
    android:gravity="center">

    <!-- Arc reactor orb -->
    <ImageView
        android:id="@+id/splash_orb"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerInParent="true"
        android:layout_marginBottom="40dp"
        android:src="@drawable/ic_orb"
        android:contentDescription="HENRY Orb" />

    <!-- H.E.N.R.Y title -->
    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/splash_orb"
        android:layout_centerHorizontal="true"
        android:text="H.E.N.R.Y"
        android:textSize="32sp"
        android:textColor="#c9a84c"
        android:letterSpacing="0.3"
        android:fontFamily="sans-serif-medium"
        android:visibility="invisible" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/splash_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="HIGHLY ENHANCED NEURAL REASONING FOR YOU"
        android:textSize="9sp"
        android:textColor="#64748b"
        android:letterSpacing="0.2"
        android:visibility="invisible" />

    <!-- Bottom version text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:text="v1.0.0"
        android:textSize="11sp"
        android:textColor="#334155" />

</RelativeLayout>
