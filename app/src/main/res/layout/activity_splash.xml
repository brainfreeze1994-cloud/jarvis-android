<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020C1B">

    <!-- Top accent line -->
    <View
        android:id="@+id/splash_top_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#00D4FF"
        android:layout_alignParentTop="true"/>

    <!-- Corner brackets TL -->
    <View android:layout_width="24dp" android:layout_height="2dp"
        android:background="#00D4FF" android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" android:layout_marginTop="14dp" android:layout_marginStart="14dp"/>
    <View android:layout_width="2dp" android:layout_height="24dp"
        android:background="#00D4FF" android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" android:layout_marginTop="14dp" android:layout_marginStart="14dp"/>
    <!-- Corner brackets TR -->
    <View android:layout_width="24dp" android:layout_height="2dp"
        android:background="#00D4FF" android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true" android:layout_marginTop="14dp" android:layout_marginEnd="14dp"/>
    <View android:layout_width="2dp" android:layout_height="24dp"
        android:background="#00D4FF" android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true" android:layout_marginTop="14dp" android:layout_marginEnd="14dp"/>
    <!-- Corner brackets BL -->
    <View android:layout_width="24dp" android:layout_height="2dp"
        android:background="#00D4FF" android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true" android:layout_marginBottom="14dp" android:layout_marginStart="14dp"/>
    <View android:layout_width="2dp" android:layout_height="24dp"
        android:background="#00D4FF" android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true" android:layout_marginBottom="14dp" android:layout_marginStart="14dp"/>
    <!-- Corner brackets BR -->
    <View android:layout_width="24dp" android:layout_height="2dp"
        android:background="#00D4FF" android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true" android:layout_marginBottom="14dp" android:layout_marginEnd="14dp"/>
    <View android:layout_width="2dp" android:layout_height="24dp"
        android:background="#00D4FF" android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true" android:layout_marginBottom="14dp" android:layout_marginEnd="14dp"/>

    <!-- Center content group -->
    <LinearLayout
        android:id="@+id/splash_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Orb icon -->
        <ImageView
            android:id="@+id/splash_orb"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="HENRY Orb" />

        <!-- H.E.N.R.Y title -->
        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="H·E·N·R·Y"
            android:textSize="38sp"
            android:textColor="#00D4FF"
            android:letterSpacing="0.4"
            android:fontFamily="sans-serif-medium"
            android:visibility="invisible" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="HYPERINTELLIGENCE ENGINE NEURAL REASONING YIELD"
            android:textSize="10sp"
            android:textColor="#4A8AAA"
            android:letterSpacing="0.14"
            android:visibility="invisible" />

        <!-- Boot status line -->
        <TextView
            android:id="@+id/splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="INITIALIZING..."
            android:textSize="12sp"
            android:textColor="#00D4FF"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            android:visibility="invisible" />

        <!-- Progress bar track -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="invisible"
            android:id="@+id/splash_progress_container">

            <!-- Background track -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:background="#0A2A3A"/>

            <!-- Progress fill -->
            <View
                android:id="@+id/splash_progress_fill"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_gravity="start|center_vertical"
                android:background="#00D4FF"/>
        </FrameLayout>

        <!-- Progress percent -->
        <TextView
            android:id="@+id/splash_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0%"
            android:textSize="11sp"
            android:textColor="#4A8AAA"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            android:visibility="invisible"/>

    </LinearLayout>

    <!-- Bottom version -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="28dp"
        android:text="v21.0.0 · HENRY AI"
        android:textSize="12sp"
        android:textColor="#2A5575" />

    <!-- Bottom accent line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#071525"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>
