<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#020C1B">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#040F1D">

        <Button
            android:id="@+id/vision_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textColor="#00D4FF"
            android:background="@null"
            android:textSize="11sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/vision_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ VISION INTELLIGENCE"
                android:textColor="#00D4FF"
                android:textSize="13sp"
                android:letterSpacing="0.2"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/vision_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#2A6A8A"
                android:textSize="9sp"
                android:letterSpacing="0.15"/>
        </LinearLayout>

        <View android:layout_width="60dp" android:layout_height="1dp"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/vision_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:progressTint="#00D4FF"
        android:visibility="gone"/>

    <!-- Camera layout (tracking mode) -->
    <FrameLayout
        android:id="@+id/vision_camera_layout"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/vision_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.jarvis.ai.VisionOverlayView
            android:id="@+id/vision_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <!-- Menu (mode selector) -->
    <ScrollView
        android:id="@+id/vision_menu_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/vision_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"/>
    </ScrollView>

    <!-- Vision Pipeline Interactive Studio (DFS & BFS) -->
    <LinearLayout
        android:id="@+id/vision_pipeline_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#020C1B">

        <!-- Preset Scenarios Selector -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:padding="6dp"
            android:background="#040F1D">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_scenario_transit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛰 Transit Grid"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"/>

                <TextView
                    android:id="@+id/chip_scenario_pcb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ PCB Circuit"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"/>

                <TextView
                    android:id="@+id/chip_scenario_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Constellations"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"/>

                <TextView
                    android:id="@+id/chip_scenario_cells"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔬 Neural Synapses"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip"/>

                <TextView
                    android:id="@+id/chip_scenario_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 Camera/Gallery"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_chip"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Pipeline Stages / Algorithm Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:background="#06162B">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_stage_bfs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🌊 BFS SEARCH"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_stage_dfs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="⚡ DFS SEARCH"
                    android:textColor="#FF9900"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_stage_compare"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="⚖️ BFS vs DFS"
                    android:textColor="#00FF99"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_stage_preprocess"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🔬 PREPROCESS"
                    android:textColor="#90CAF9"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_stage_edges"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="📐 SOBEL EDGES"
                    android:textColor="#90CAF9"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Interactive Pipeline Canvas View -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.jarvis.ai.pipeline.VisionPipelineView
                android:id="@+id/vision_pipeline_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <!-- Traversal Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:background="#040F1D">

            <Button
                android:id="@+id/btn_pipeline_play"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="▶ PLAY"
                android:textColor="#00FF99"
                android:textSize="11sp"
                android:background="@drawable/bg_chip"/>

            <Button
                android:id="@+id/btn_pipeline_step"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⏭ STEP"
                android:textColor="#00D4FF"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip"/>

            <Button
                android:id="@+id/btn_pipeline_reset"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔄 RESET"
                android:textColor="#FF8A80"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip"/>

            <Button
                android:id="@+id/btn_pipeline_speed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⚡ 1x"
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_pipeline_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap node: set Goal"
                android:textColor="#2A6A8A"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Real-time Telemetry & Educational Metrics Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#031024">

            <TextView
                android:id="@+id/tv_pipeline_step_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Initialized search."
                android:textColor="#C0E8FF"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_metric_visited"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Visited: 0/0"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tv_metric_memory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Queue Peak: 0"
                    android:textColor="#BA68C8"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tv_metric_hops"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hops: --"
                    android:textColor="#FFDD00"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Result area -->
    <ScrollView
        android:id="@+id/vision_result_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/vision_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#C0E8FF"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:fontFamily="monospace"/>
    </ScrollView>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#040F1D">

        <Button
            android:id="@+id/vision_btn_gallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="🖼 GALLERY"
            android:textColor="#00D4FF"
            android:background="@drawable/bg_chip"
            android:textSize="12sp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/vision_btn_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="📷 CAMERA"
            android:textColor="#00D4FF"
            android:background="@drawable/bg_chip"
            android:textSize="12sp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/vision_btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="🔄"
            android:textColor="#00D4FF"
            android:background="@drawable/bg_chip"
            android:textSize="16sp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
