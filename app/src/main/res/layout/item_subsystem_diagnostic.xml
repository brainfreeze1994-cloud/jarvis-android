<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_diagnostic_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Name, Category, Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_subsystem_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Subsystem Name"
            android:textColor="#00D4FF"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tv_subsystem_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASS"
            android:textColor="#00FFCC"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Test Name & Result -->
    <TextView
        android:id="@+id/tv_subsystem_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Test: Verification"
        android:textColor="#8AB4F8"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <!-- Subsystem Summary -->
    <TextView
        android:id="@+id/tv_subsystem_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Operational status summary."
        android:textColor="#C5D9EB"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <!-- Error / Reason (if failed or warning) -->
    <TextView
        android:id="@+id/tv_subsystem_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Reason: ..."
        android:textColor="#FFB800"
        android:textSize="11sp"
        android:background="#20FFB800"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Recommended Fix -->
    <TextView
        android:id="@+id/tv_subsystem_fix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Suggested action: ..."
        android:textColor="#00FFCC"
        android:textSize="11sp"
        android:background="#1500FFCC"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Telemetry Details Container -->
    <LinearLayout
        android:id="@+id/layout_telemetry_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:paddingTop="6dp"
        android:background="#0800D4FF"
        android:paddingHorizontal="8dp"
        android:paddingBottom="6dp" />

    <!-- Bottom Row: Latency indicator & Dependencies -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_subsystem_latency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱️ Latency: 24 ms"
            android:textColor="#668DA8"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_subsystem_deps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deps: AI Core"
            android:textColor="#668DA8"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
