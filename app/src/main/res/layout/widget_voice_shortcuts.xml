<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC020C1B"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="H.E.N.R.Y"
        android:textColor="#FF00BEFF"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:gravity="center"
        android:paddingBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wb_btn1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#FF041828"
            android:textColor="#FF00BEFF"
            android:textSize="11sp"
            android:gravity="center"
            android:text="📰 News"/>

        <TextView
            android:id="@+id/wb_btn2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#FF041828"
            android:textColor="#FF00BEFF"
            android:textSize="11sp"
            android:gravity="center"
            android:text="☀️ Weather"/>

        <TextView
            android:id="@+id/wb_btn3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#FF041828"
            android:textColor="#FF00BEFF"
            android:textSize="11sp"
            android:gravity="center"
            android:text="📅 Reminder"/>

        <TextView
            android:id="@+id/wb_btn4"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="#FF041828"
            android:textColor="#FF00BEFF"
            android:textSize="11sp"
            android:gravity="center"
            android:text="🎵 Music"/>

    </LinearLayout>

    <TextView
        android:id="@+id/wb_mic"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="#FF00BEFF"
        android:textColor="#FF020C1B"
        android:textSize="13sp"
        android:gravity="center"
        android:text="🎤  SPEAK TO HENRY"/>

</LinearLayout>
