<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jarvis" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#070d1a</item>
        <item name="android:statusBarColor">#070d1a</item>
        <item name="android:navigationBarColor">#070d1a</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">#3b82f6</item>
        <item name="colorPrimaryDark">#1d4ed8</item>
        <item name="colorAccent">#3b82f6</item>
    </style>

    <style name="Theme.Jarvis.Splash" parent="Theme.Jarvis">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#070d1a</item>
    </style>

    <style name="Theme.Jarvis.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">#070d1a</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textColorSecondary">#94a3b8</item>
        <item name="colorPrimary">#3b82f6</item>
        <item name="colorAccent">#00E5FF</item>
    </style>

    <style name="Theme.HENRY" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#06B6D4</item>
        <item name="colorPrimaryVariant">#0891B2</item>
        <item name="colorOnPrimary">#070B14</item>
        <item name="android:statusBarColor">#070B14</item>
    </style>
</resources>
